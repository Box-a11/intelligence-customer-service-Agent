# 复制本文件为 .env 并按需填写。所有项均可省略。

# ---- LLM（OpenAI 兼容接口）----
# 留空 LLM_API_KEY 时自动回退到离线 Mock（测试/评测零成本可跑）。
# 常见兼容端点：
#   DeepSeek  : LLM_BASE_URL=https://api.deepseek.com            LLM_MODEL=deepseek-v4-pro
#   通义千问   : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   智谱 GLM   : LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4
#   OpenAI     : LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# DeepSeek 不提供 embedding 接口，留空则检索回退本地哈希嵌入。
EMBED_MODEL=

# ---- 本地语义 embedding ----
# 检索向量后端：local=本地 bge 语义向量（推荐，需已安装 sentence-transformers）；
# hash=离线哈希嵌入（确定性，测试/评测默认）。
EMBED_BACKEND=local
# 本地 sentence-transformers 中文向量模型（首次运行从 HF 缓存加载，无需联网）。
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# ---- 检索 ----
TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=50
SCORE_THRESHOLD=0.25
